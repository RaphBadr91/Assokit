# ============================================================
#  Today AI Refresh
# ============================================================

RewriteRule ^today-ai-refresh/?$    today-ai-refresh.php [L,QSA]

# ============================================================
#  Pack #5 — Synchro calendrier (iCal feed via token)
# ============================================================

RewriteRule ^ical/([a-f0-9]{32,64})\.ics$  ical-feed.php?t=$1 [L,QSA]

# ============================================================
#  Guide On Boarding 
# ============================================================

RewriteRule ^guide-onboarding-done/?$    guide-onboarding-done.php [L,QSA]

# ============================================================
# 2.1 ROUTES SUPER ADMIN (V16 / V16.1 / ULTIME - avril 2026)
# ============================================================
# /super-admin                   → /super-admin.php              (dashboard)
# /super-admin/nouvelle-asso     → /super-admin-nouvelle-asso.php
# /super-admin/logs              → /super-admin-logs.php
# /super-admin/super-admins      → /super-admin-super-admins.php
# /super-admin/associations      → /super-admin-associations.php
# /super-admin/projets           → /super-admin-projets.php
# /super-admin/abonnements       → /super-admin-abonnements.php
# /super-admin/stats             → /super-admin-stats.php        (Fondateur uniquement)
# /super-admin/notifications     → /super-admin-notifications.php (Fondateur uniquement)
# /super-admin/support           → /super-admin-support.php       (Pack 2)
# /super-admin/support/42        → /super-admin-support-ticket.php?id=42 (Pack 2)
# ============================================================

# Routes avec segments (doivent etre AVANT la regle generique plus bas)
RewriteRule ^super-admin/nouvelle-asso/?$         super-admin-nouvelle-asso.php [L,QSA]
RewriteRule ^super-admin/logs/?$                  super-admin-logs.php [L,QSA]
RewriteRule ^super-admin/super-admins/?$          super-admin-super-admins.php [L,QSA]
# Pack #5A — Facturation asso (DOIT être avant la regle generique associations)
RewriteRule ^super-admin/associations/facturation/save/?$   super-admin-association-facturation-save.php [L,QSA]
RewriteRule ^super-admin/associations/facturation/?$        test-meta.php [L,QSA]
RewriteRule ^super-admin/associations/?$          super-admin-associations.php [L,QSA]
RewriteRule ^mon-asso/facturation/?$              mon-asso-facturation.php [L,QSA]
RewriteRule ^super-admin/projets/?$               super-admin-projets.php [L,QSA]
RewriteRule ^super-admin/abonnements/?$           super-admin-abonnements.php [L,QSA]
RewriteRule ^super-admin/stats/?$                 super-admin-stats.php [L,QSA]
RewriteRule ^super-admin/notifications/?$         super-admin-notifications.php [L,QSA]

# Incarnation
RewriteRule ^super-admin/incarner/?$                  super-admin-impersonate.php [L,QSA]
RewriteRule ^super-admin/incarner-stop/?$             super-admin-stop-impersonation.php [L,QSA]
RewriteRule ^super-admin/logs-incarnation/?$          super-admin-impersonation-logs.php [L,QSA]

# Sécurité : bloquer l'accès direct au helper et à la bannière
<Files "impersonation-helpers.php">
    Require all denied
</Files>

<Files "impersonation-banner.php">
    Require all denied
</Files>


# Pack 2 Support — cote cockpit
RewriteRule ^super-admin/support/?$               super-admin-support.php [L,QSA]
RewriteRule ^super-admin/support/(\d+)/?$         super-admin-support-ticket.php?id=$1 [L,QSA]

# Pour les futures versions (V16.2 gestion asso, V16.3 incarnation) :
# RewriteRule ^super-admin/asso/(\d+)/?$          super-admin-asso.php?id=$1 [L,QSA]
# RewriteRule ^super-admin/impersonate/?$         super-admin-impersonate.php [L,QSA]

# ============================================================
# 2.2 ROUTES COMMUNICATION (V15 - avril 2026)
# ============================================================
# /communication                     → /communication.php
# /communication-generer             → /communication-generer.php (avec ?type=X)
# /communication-template-save       → /communication-template-save.php (POST AJAX)
# Ces URLs simples sont gerees par la regle generique plus bas,
# mais on les explicite pour la clarte et les futures versions.
# ============================================================

# Pour la V2 (template avec ID) :
# RewriteRule ^communication-template/(\d+)/?$   communication-template.php?id=$1 [L,QSA]

# ============================================================
# 2.3 ROUTES PACK 2 SUPPORT - COTE ASSO (avril 2026)
# ============================================================
# /support                   → /support.php              (liste tickets asso)
# /support/nouveau           → /support-nouveau.php      (creer ticket)
# /support/ticket/42         → /support-ticket.php?id=42 (fiche + fil conversation)
# ============================================================

RewriteRule ^support/?$                           support.php [L,QSA]
RewriteRule ^support/nouveau/?$                   support-nouveau.php [L,QSA]
RewriteRule ^support/ticket/(\d+)/?$              support-ticket.php?id=$1 [L,QSA]

# ========== Pack #5-ZERO — Paramètres société ==========
RewriteRule ^fondateur-cockpit/societe/?$              super-admin-parametres-societe.php [L,QSA]
RewriteRule ^fondateur-cockpit/societe/save/?$         super-admin-parametres-societe-save.php [L,QSA]

# ============================================================
# 2.4 ROUTES ADHÉRENTS - Ajout / Export / Import CSV
# ============================================================
RewriteRule ^nouveau-adherent/?$         nouveau-adherent.php [L,QSA]
RewriteRule ^adherents-export/?$         adherents-export.php [L,QSA]
RewriteRule ^adherents-import/?$         adherents-import.php [L,QSA]
RewriteRule ^rgpd-export/?$              rgpd-export.php [L,QSA]
RewriteRule ^rgpd-supprimer-compte/?$    rgpd-supprimer-compte.php [L,QSA]
RewriteRule ^securite-2fa/?$              securite-2fa.php [L,QSA]
RewriteRule ^connexion-2fa/?$             connexion-2fa.php [L,QSA]
RewriteRule ^modifier-adherent/(\d+)/?$      modifier-adherent.php?id=$1 [L,QSA]

# ============================================================
# 3. URLS PROPRES (sans .php) POUR LES PAGES SIMPLES
# ============================================================
RewriteCond %{REQUEST_METHOD} !=POST
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Prospection : liens personnalisés de tracking + désinscription (jeton)
RewriteRule ^p/([0-9]+\.[a-f0-9]+)/?$               p.php?t=$1 [L,QSA]
RewriteRule ^desinscription/([0-9]+\.[a-f0-9]+)/?$  desinscription.php?t=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# ========== Niveau 2 sécurité SA ==========

# Login / logout dédiés au cockpit Fondateur
RewriteRule ^super-admin-login/?$              super-admin-login.php [L,QSA]
RewriteRule ^super-admin-logout/?$             super-admin-logout.php [L,QSA]

# Logs d'accès (Fondateur only)
RewriteRule ^fondateur-cockpit/access-logs/?$  super-admin-access-logs.php [L,QSA]

# URL discrète alias vers le dashboard SA
RewriteRule ^fondateur-cockpit/?$              super-admin.php [L,QSA]
RewriteRule ^fondateur-cockpit/(.+)$           super-admin/$1 [L,QSA]

# Pack #5B — Factures PDF
RewriteRule ^super-admin/factures/generate/?$   super-admin-facture-generate.php [L,QSA]
RewriteRule ^super-admin/factures/?$            super-admin-factures.php [L,QSA]



# ============================================================
# Pack #3 — CRON automations (ajouté le 24/04/2026)
# ============================================================
RewriteRule ^admin-cron/?$                  admin-cron.php [L,QSA]
RewriteRule ^admin-cron-detail/?$           admin-cron-detail.php [L,QSA]
RewriteRule ^admin-cron-run-manual/?$       admin-cron-run-manual.php [L,QSA]

# ========== Cockpit CRON login (sécurité réauth 15 min) ==========
RewriteRule ^admin-cron-login/?$             admin-cron-login.php [L,QSA]
RewriteRule ^admin-cron-logout/?$            admin-cron-logout.php [L,QSA]

# Sécurité : bloquer l'accès direct aux fichiers internes CRON
<Files "cron-includes.php">
    Require all denied
</Files>
<Files "cron-email-templates.php">
    Require all denied
</Files>
<Files "cron-job-impayes.php">
