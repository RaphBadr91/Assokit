RewriteRule ^supprimer-dossier/(\d+)/?$   supprimer-dossier.php?id=$1 [L,QSA]
RewriteRule ^supprimer-subvention/(\d+)/?$   supprimer-subvention.php?id=$1 [L,QSA]

# Session 9 — Mairies/Collectivités
RewriteRule ^mairie-dashboard/?$ mairie-dashboard.php [L,QSA]
RewriteRule ^mairie-asso/?$ mairie-asso.php [L,QSA]
RewriteRule ^mairie-associations/?$ mairie-associations.php [L,QSA]
RewriteRule ^mairie-support/?$ mairie-support.php [L,QSA]
