# ============================================================
# 4. PROTÉGER LES FICHIERS SENSIBLES
# ============================================================
<Files "config.php">
    Require all denied
</Files>

<Files "ai-helper.php">
    Require all denied
</Files>

<Files "google-helper.php">
    Require all denied
</Files>

<Files "resend-helper.php">
    Require all denied
</Files>

<Files "sms-helper.php">
    Require all denied
</Files>

<Files "sa-permissions.php">
    Require all denied
</Files>

<Files "support-helper.php">
    Require all denied
</Files>

<Files "includes-cotisations.php">
    Require all denied
</Files>

<FilesMatch "\.(sql|md|log|env|bak|swp|txt)$">
    Require all denied
</FilesMatch>
# robots.txt doit rester public pour le SEO (exception au blocage .txt)
<Files "robots.txt">
    Require all granted
</Files>

<Files ".htaccess">
    Require all denied
</Files>



# ============================================================
# 5. SÉCURITÉ DE BASE
# ============================================================
Options -Indexes

# ============================================================
# COMPRESSION (brotli si dispo, sinon gzip) — gros gain LCP/FCP
# ============================================================
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
        application/javascript application/json application/xml image/svg+xml \
        application/rss+xml font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript text/javascript application/json application/xml \
        image/svg+xml application/rss+xml application/x-font-ttf font/ttf font/otf
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    # CSS/JS servis avec ?v=filemtime (cache-busting) -> 1 an sans risque de périmé
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Médias & polices : jamais modifiés en place -> immutable 1 an (sûr)
    <FilesMatch "\.(woff2|woff|ttf|otf|svg|png|jpe?g|webp|avif|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # CSS/JS : tous ne sont pas versionnés (?v=filemtime) -> long cache MAIS revalidable
    # (pas d'immutable, sinon une version modifiée resterait figée jusqu'à 1 an chez les visiteurs)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# ════════════════════════════════════════════════
# SÉCURITÉ — ajouté lors de l'audit (defense in depth)
# ════════════════════════════════════════════════

# Headers de sécurité (ne cassent pas les styles/scripts inline)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Bloquer l'accès aux fichiers sensibles (defense in depth vs mod_security)
<FilesMatch "\.(bak|bak[0-9]|sql|zip|tar|gz|old|save|swp|log|ini|sh|env|dist|orig|tmp)$|~$|\.bak\.|\.bak[0-9]\.">
    Require all denied
</FilesMatch>

# Bloquer les fichiers cachés (.env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Bloquer TOUT le dossier .git (le FilesMatch ci-dessus ne couvre pas
# /.git/config, /.git/HEAD... dont le nom de fichier ne commence pas par un point)
RedirectMatch 404 /\.git

# Defense en profondeur : bloquer les scripts d'outillage/debug residuels
<FilesMatch "^(diag-|test-|fix-branding|restore-branding|cron-login-diagnostic|PATCH-|SNIPPET)">
    Require all denied
</FilesMatch>

# ════════════════════════════════════════════════
# VERROUILLAGE WORDPRESS (vecteurs d'attaque inutilisés)
# Le front /blog reste accessible — on bloque seulement admin & API
# ════════════════════════════════════════════════

# xmlrpc.php : vecteur DDoS/brute-force majeur → bloqué
<Files "xmlrpc.php">
    Require all denied
</Files>

# wp-login & wp-cron (admin via admin-blog custom, pas wp-admin)
<Files "wp-login.php">
    Require all denied
</Files>
<Files "wp-cron.php">
    Require all denied
</Files>

# wp-admin (renvoie 500, non utilisé) + énumération users
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Bloquer wp-admin (sauf admin-ajax si jamais nécessaire au front)
    RewriteRule ^wp-admin/(?!admin-ajax\.php) - [F,L]
    # Bloquer l'énumération des auteurs WP (?author=1)
    RewriteCond %{QUERY_STRING} (^|&)author=\d [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# ════════════════════════════════════════════════
# ANTI-BOTS — scanners de vulnérabilités / outils d'attaque
# (liste volontairement limitée aux outils offensifs = zéro faux positif)
# ════════════════════════════════════════════════
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|nessus|acunetix|wpscan|dirbuster|gobuster|havij|jorgee|zmeu|w3af|openvas|webinspect|paros|nuclei|fimap|whatweb|xsser) [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# ════════════════════════════════════════════════
# CSP en mode REPORT-ONLY (observation — ne bloque RIEN)
# Appliqué à l'app, pas au blog WP/Elementor (console propre)
# Les violations s'affichent dans la console navigateur (F12)
# ════════════════════════════════════════════════
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/blog" AK_IS_WP
    SetEnvIf Request_URI "^/wp-" AK_IS_WP
</IfModule>
<IfModule mod_headers.c>
    Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://js.stripe.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://www.youtube.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://api-adresse.data.gouv.fr https://accounts.google.com; frame-src 'self' https://js.stripe.com https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com https://js.stripe.com" env=!AK_IS_WP
</IfModule>
