# ============================================================
# Dossier uploads — Sécurité
# ============================================================
# Bloque l'exécution de tout fichier PHP qui pourrait être uploadé par erreur
# (empêche un attaquant d'uploader un fichier .php et de l'exécuter)
# ============================================================

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|pl|py|jsp|asp|htm|shtml|sh|cgi)$">
    Require all denied
</FilesMatch>

# Pas de listing du dossier
Options -Indexes

# ============================================================
# Fichiers de projet : accès direct HTTP INTERDIT.
# Ils contiennent des justificatifs/factures confidentiels et sont
# servis uniquement via /fichier-projet (login + contrôle d'org).
# Le proxy PHP (readfile) et la génération PDF (mPDF, lecture disque)
# ne sont PAS affectés.
# ============================================================
RewriteEngine On
RewriteRule ^projet_ - [F,L]
