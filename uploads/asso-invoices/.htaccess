# ============================================================
# Dossier uploads — Sécurité
# ============================================================
# Bloque l'exécution de tout fichier PHP qui pourrait être uploadé par erreur
# (empêche un attaquant d'uploader un fichier .php et de l'exécuter)
# ============================================================

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|pht|phps|pl|py|jsp|asp|htm|html|xhtml|shtml|svg|svgz|xml|sh|cgi)$">
    Require all denied
</FilesMatch>

# Pas de listing du dossier
Options -Indexes
