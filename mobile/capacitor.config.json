{
  "appId": "fr.assokit.app",
  "appName": "Assokit",
  "webDir": "www",
  "server": {
    "url": "https://assokit.fr",
    "cleartext": false,
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "backgroundColor": "#059669",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#059669",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#047857"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false
  }
}
