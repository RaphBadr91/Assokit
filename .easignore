# ============================================================
# .easignore — allège l'archive EAS Build.
# On exclut le site web PHP lourd (surtout wp-content), MAIS on ne
# touche JAMAIS au dossier mobile/ (il n'est listé nulle part ici,
# donc tout son contenu — dont package.json — est bien inclus).
# Syntaxe identique à .gitignore. N'affecte QUE les builds EAS.
# ============================================================
/admin-blog/
/api/
/assets/
/company/
/cron-locks/
/css/
/demo-sql/
/icons/
/migrations/
/wp-content/
